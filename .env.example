# Copy this to .env and fill in your values.
# .env is gitignored — never commit credentials.

# Option A: credential-based login (used by `fidelity-mcp login`)
FIDELITY_USERNAME=your_fidelity_username
FIDELITY_PASSWORD=your_fidelity_password

# Optional: TOTP secret for automated 2FA (base32 string from your authenticator setup)
# FIDELITY_TOTP_SECRET=BASE32SECRET

# Option B: paste session cookies directly (advanced)
# Export cookies as a JSON object from browser DevTools after logging in manually.
# FIDELITY_SESSION_COOKIES={"fidelity-sso":"...","optanon":"..."}
